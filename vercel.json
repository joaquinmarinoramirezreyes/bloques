{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/80", "destination": "/index.html" },
    { "source": "/80/", "destination": "/index.html" },
    { "source": "/90", "destination": "/index.html" },
    { "source": "/90/", "destination": "/index.html" },
    { "source": "/00", "destination": "/index.html" },
    { "source": "/00/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
